.bash_history

# Environment
.env
*.env.local

# Data
data/input/*
data/output/*
!data/input/.gitkeep
!data/output/.gitkeep

# Logs
logs/*.log

# OS
.DS_Store
Thumbs.db

# Backup archives
*.tar.gz

# Generated annotation work (per-annotator templates, filled by humans)

# Analyst-ONLY ground truth for the blinded experiment (must never reach annotators
# or be committed alongside the annotation files). Kept out of git deliberately.
experiment/blinded/ground_truth_blinded.json

# Blank experiment annotation templates (filled by humans). Keep out of git until
# a human actually fills them; commit filled files explicitly (git add -f).
experiment/held_out_work/ann*.jsonl

# Calibration WORK templates (filled to resolve the 4 calibration ties). These
# are part of the reproducibility evidence, so unlike held_out_work helper
# files they are not swept by `make clean-all`.
experiment/calibration_work/manifest.json

.pytest_cache

# Internal planning documents (not part of the repository deliverable)
plan*.md


# Pre-publication draft (not for public release)
docs/pre-publication-*
docs/paper-part3-*


# Sealed keeper passphrase (access control — never commit private key material)
experiment/.sealed_keeper.*
sealed_keeper.*
# Sealed experiment artifacts (templates, encrypted labels, annotations)
experiment/.sealed_work/

# Sealed-randomization BUILD artifacts (regenerate via `make experiment-*`)
experiment/sealed/templates/
experiment/sealed/labels/
experiment/annotations/
experiment/rater_declarations/
experiment/agreements/
experiment/gold/
experiment/reports/
experiment/manifests/annotation_manifest.json
