# Python
__pycache__/
*.py[cod]
*.egg-info/
.egs/
dist/
build/

# IDE
.vscode/
.idea/
*.swp
*.swo
.agents/
.venv/
.ruff_cache/
.bash_history

# Environment
.env
*.env.local

# Logs
logs/*.log

# OS
.DS_Store
Thumbs.db
plan*.md
.pytest_cache/

# Backup archives
*.tar.gz

# Internal planning documents (not part of the repository deliverable)
plan*.md

# Internal human-readable final report (researcher-only, NOT for the reviewer)
FINAL_REPORT.md

# Analyst-ONLY ground truth for the blinded experiment (must never reach
# annotators or be committed alongside the annotation files).
experiment/blinded/ground_truth_blinded.json

# Sealed keeper passphrase (access control — never commit private key material)
experiment/.sealed_keeper.*
sealed_keeper.*

# Sealed experiment artifacts — regenerable BUILD outputs (make experiment-seal):
# keep the sealed templates and encrypted labels OUT of git (blind protocol).
experiment/.sealed_work/
experiment/sealed/templates/
# Ignore everything inside sealed/labels/ except the committed plaintext
# auto-labels used for reproducible gold reconstruction: this committed file
# lets 'make experiment-gold' rebuild gold from git without the passphrase
# (reproducibility), while the *.enc and other label artifacts stay out.
experiment/sealed/labels/*
!experiment/sealed/labels/auto_labels.jsonl

# NOTE: the *filled* annotations, agreements, gold labels, agreement reports,
# the annotation manifest and the rater declarations ARE committed for reviewer
# audit, so they are deliberately NOT listed below.

# Working audit notes — not part of the reviewer-facing results set
AUDIT_REVIEW.md
