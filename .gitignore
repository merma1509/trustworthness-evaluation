# Generated annotation work (per-annotator templates, filled by humans)

# Analyst-ONLY ground truth for the blinded experiment (must never reach annotators
# or be committed alongside the annotation files). Kept out of git deliberately.
experiment/blinded/ground_truth_blinded.json

# Blank experiment annotation templates (filled by humans). Keep out of git until
# a human actually fills them; commit filled files explicitly (git add -f).
experiment/held_out_work/ann*.jsonl

# Calibration WORK templates (filled to resolve the 4 calibration ties). These
# are part of the reproducibility evidence, so unlike held_out_work helper
# files they are not swept by `make clean-all`.
experiment/calibration_work/manifest.json

.pytest_cache

